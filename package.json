{
  "name": "timetrack",
  "productName": "TimeTrack",
  "version": "1.4.0",
  "description": "Desktop time tracking application",
  "main": "main.js",
  "author": "TimeTrack",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build-app": "cd app && npm install && npm run build",
    "make": "npm run build-app && electron-builder --win --x64",
    "make:dir": "npm run build-app && electron-builder --win --x64 --dir"
  },
  "build": {
    "appId": "com.timetrack.app",
    "productName": "TimeTrack",
    "copyright": "Copyright © 2026 TimeTrack",
    "buildDependenciesFromSource": false,
    "npmRebuild": false,
    "directories": {
      "output": "dist-electron",
      "app": "."
    },
    "files": [
      "main.js",
      "preload.js",
      "app/dist/**/*",
      "build/icon.ico",
      "!**/node_modules/**/*"
    ],
    "asarUnpack": [
      "app/dist/**/*"
    ],
    "extraResources": [],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "requestedExecutionLevel": "asInvoker",
      "forceCodeSigning": false,
      "signAndEditExecutable": false,
      "signtoolOptions": {
        "signingHashAlgorithms": [
          "sha256"
        ]
      }
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TimeTrack",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "deleteAppDataOnUninstall": false
    },
    "afterPack": "./scripts/afterPack.cjs"
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3"
  },
  "overrides": {
    "keyv": "4.5.4",
    "cacheable-request": "7.0.4"
  },
  "_securityNote": "SECURITY: keyv and cacheable-request are pinned via `overrides` above due to the August 2026 Keyv/Cacheable npm supply chain attack (compromised keyv@6.0.0, cacheable-request@13.0.20 and 400+ other packages; see https://www.wiz.io/blog/keyv-and-cacheable-npm-supply-chain-attack). Do not remove these overrides or let `npm update`/a dependency bump move them past 4.5.4 / 7.0.4 without first checking npm advisories to confirm the ecosystem has fully recovered and newer versions are verified clean."
}
